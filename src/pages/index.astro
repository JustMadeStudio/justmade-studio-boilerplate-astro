---
import Base from '@/layouts/Base.astro';
// import { studio, safe, cdn, slContent, slCollection, slItem } from '@/lib/studio';
// import CdnImage from '@/components/CdnImage.astro';
// import CdnSource from '@/components/CdnSource.astro';

// Example: fetch content from Justmade Studio (safe() = a CMS hiccup is no 500).
// const posts = await safe(() => studio.dataset('blog', 'posts').list(), []);

const title = 'Justmade Studio Astro Boilerplate';
const description = 'Astro SSR + Justmade Studio headless CMS, with same-origin media cloaking.';
---
<Base title={title} description={description}>
  <main class="mx-auto max-w-2xl px-6 py-24">
    <h1 class="text-4xl font-bold tracking-tight">{title}</h1>
    <p class="mt-4 text-lg opacity-70">{description}</p>

    <ul class="mt-10 space-y-2 text-sm">
      <li>✓ Astro SSR (node standalone adapter)</li>
      <li>✓ Tailwind 4 via <code>@tailwindcss/vite</code></li>
      <li>✓ Justmade Studio client in <code>src/lib/studio.ts</code></li>
      <li>✓ Media cloaking at <code>/cdn/&lt;uuid&gt;</code> (resize + AVIF/WebP + cache)</li>
      <li>✓ Inline editing in the studio and the client portal (<code>data-sl-*</code> via <code>src/lib/edit.ts</code>)</li>
      <li>✓ Indexing guard (only the production host is indexable)</li>
      <li>✓ Prod-ready Docker (multi-stage)</li>
    </ul>

    {/*
      Editable content: tag the element that renders the raw value, so the
      studio's preview and the client portal's visual editor can change it:

      <h2 {...slContent('site', 'home', 'title')}>{home.data.title}</h2>

      An editable list (add, delete, reorder from the page):

      <ul {...slCollection('blog', 'posts')}>
        {posts.map((p) => (
          <li {...slItem(p.uid)}>
            <h3 {...slContent('blog', 'posts', 'title', p.uid)}>{p.data.title}</h3>
          </li>
        ))}
      </ul>

      Cloaked image, once you have a CMS URL:

      <CdnImage src={post.cover} alt={post.title} width={960}
                sizes="(min-width:768px) 50vw, 100vw" priority />

      Or a full <picture> with AVIF -> WebP fallback:

      <picture>
        <CdnSource src={post.cover} format="avif" widths={[640,960,1280]} sizes="50vw" />
        <CdnSource src={post.cover} format="webp" widths={[640,960,1280]} sizes="50vw" />
        <CdnImage  src={post.cover} alt={post.title} width={960} />
      </picture>

      Or the primitive anywhere a URL goes:  cdn(url, { w: 1280, f: 'avif' })
    */}

    <p class="mt-10 text-sm opacity-60">
      Copy <code>.env.example</code> to <code>.env</code>, fill in your Justmade Studio key,
      and start with <code>npm run dev</code>. See <code>README.md</code>.
    </p>
  </main>
</Base>
