# Public site URL (canonical, OG tags, sitemap). No trailing slash.
PUBLIC_SITE_URL=http://localhost:4321

# ─── Justmade Studio headless CMS ────────────────────────────────────────────
# Your Justmade Studio Content API key.
# Store the real value as a secret in your host's env, never hardcoded in the repo.
JUSTMADE_API_KEY=

# Justmade Studio API base URL (app origin). Defaults to the hosted deployment.
JUSTMADE_BASE_URL=https://studio.justmade.be

# Project slug in Justmade Studio (determines the default media bucket, among others).
JUSTMADE_PROJECT=

# ─── Media cloaking (/cdn/<uuid>) ────────────────────────────────────────────
# CDN origin where the Justmade Studio media lives. Used server-side only,
# never leaks to the client. Usually no need to change.
# (Host is still the legacy CDN domain; the bucket was never renamed.)
JUSTMADE_CDN_ORIGIN=https://cdn.studiolayer.io

# Bucket prefix for bare keys (/cdn/<uuid> -> <bucket>/<uuid>).
# Default: production/projects/<JUSTMADE_PROJECT>/
# Only set this if you use a non-standard bucket.
# JUSTMADE_CDN_BUCKET=
